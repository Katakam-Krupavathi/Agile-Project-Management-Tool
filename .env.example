# Application
APP_NAME=Agile Project Management Tool
APP_ENV=development
DEBUG=false

# API Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Database (SQLite WAL)
DATABASE_URL=sqlite:///./data/agile_pm.db

# Security (replace with strong random values in .env)
SECRET_KEY=change-me-to-a-long-random-secret
SESSION_COOKIE_NAME=agile_pm_session
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_NAME=agile_pm_csrf

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
