# Application
APP_NAME=Agile Project Management Tool
APP_ENV=development
DEBUG=false

# API Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Database (SQLite WAL)
DATABASE_URL=sqlite:///./data/agile_pm.db

# Security (replace SECRET_KEY with a strong random value >= 32 characters)
SECRET_KEY=replace-with-at-least-32-random-bytes-secret-key
SESSION_COOKIE_NAME=agile_pm_session
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_NAME=agile_pm_csrf
FORWARDED_ALLOW_IPS=127.0.0.1
SEED_DEMO=false

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
